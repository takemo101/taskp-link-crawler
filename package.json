{
	"name": "taskp-link-crawler",
	"version": "0.1.0",
	"description": "技術ドキュメントサイトをクロールし、AIコンテキスト用のMarkdownとして保存する taskp スキル",
	"license": "MIT",
	"author": "takemo101",
	"keywords": [
		"crawler",
		"documentation",
		"markdown",
		"ai-context",
		"playwright",
		"cli-tool",
		"web-scraping"
	],
	"type": "module",
	"bin": {
		"crawl": "./src/crawl.ts"
	},
	"scripts": {
		"prepare": "lefthook install",
		"prepack": "bun run build",
		"dev": "bun run src/crawl.ts",
		"build": "bun build src/crawl.ts --outdir dist --target node --external playwright --external playwright-core",
		"postbuild": "node scripts/fix-shebang.js",
		"check": "biome check .",
		"lint": "biome check .",
		"fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "bun x vitest run",
		"test:watch": "bun x vitest",
		"pretest:coverage": "rm -rf coverage",
		"test:coverage": "bun x vitest run --coverage"
	},
	"dependencies": {
		"@mozilla/readability": "^0.6.0",
		"commander": "^13.0.0",
		"jsdom": "^28.0.0",
		"playwright": "^1.59.1",
		"turndown": "^7.2.0",
		"turndown-plugin-gfm": "^1.0.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"lefthook": "^1.0.0",
		"@types/bun": "^1.2.0",
		"@types/jsdom": "^27.0.0",
		"@types/turndown": "^5.0.5",
		"@vitest/coverage-v8": "^4.0.18",
		"typescript": "^5.8.0",
		"vitest": "^4.0.18"
	},
	"engines": {
		"bun": ">=1.2.0"
	},
	"files": [
		"dist",
		"src",
		"scripts",
		"README.md",
		"SKILL.md"
	]
}
